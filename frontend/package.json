{
  "name": "rolelens-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "node e2e/smoke.cjs",
    "screenshots": "node e2e/smoke.cjs --screenshots-only",
    "format": "prettier --write src e2e vite.config.js index.html",
    "format:check": "prettier --check src e2e vite.config.js index.html"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.10",
    "vite": "^6.3.5"
  }
}
